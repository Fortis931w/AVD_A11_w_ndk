# Android SDK location. ANDROID_HOME is also accepted.
ANDROID_SDK_ROOT=/opt/android-sdk

# AVD settings
AVD_NAME=Touken
API_LEVEL=30
SYSTEM_IMAGE_TAG=default
SYSTEM_IMAGE_ABI=x86_64
CPU_CORES=2
RAM_MB=2048
DATA_SIZE=10G
LCD_WIDTH=1280
LCD_HEIGHT=720
LCD_DENSITY=240
EMULATOR_PORT=5560

# Optional APK installed by scripts/install-apk.sh (never committed).
APP_APK=/path/to/application.apk
APP_ABI=arm64-v8a
